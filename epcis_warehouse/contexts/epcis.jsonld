{
  "@context": {
    "epcis": "https://ns.gs1.org/epcis/",
    "cbv": "https://ns.gs1.org/cbv/",
    "type": "@type",
    "EPCISDocument": "epcis:EPCISDocument",
    "EPCISQueryDocument": "epcis:EPCISQueryDocument",
    "ObjectEvent": "epcis:ObjectEvent",
    "AggregationEvent": "epcis:AggregationEvent",
    "TransformationEvent": "epcis:TransformationEvent",
    "TransactionEvent": "epcis:TransactionEvent",
    "AssociationEvent": "epcis:AssociationEvent",
    "QuantityElement": "epcis:QuantityElement",
    "Source": "epcis:Source",
    "Destination": "epcis:Destination",
    "eventList": {"@id": "epcis:eventList", "@container": "@list"},
    "eventID": "epcis:eventID",
    "eventTime": "epcis:eventTime",
    "eventTimeZoneOffset": "epcis:eventTimeZoneOffset",
    "recordTime": "epcis:recordTime",
    "action": "epcis:action",
    "bizStep": {"@id": "epcis:bizStep", "@type": "@id"},
    "disposition": {"@id": "epcis:disposition", "@type": "@id"},
    "parentID": {"@id": "epcis:parentID", "@type": "@id"},
    "epcList": {"@id": "epcis:epcList", "@type": "@id", "@container": "@list"},
    "childEPCs": {"@id": "epcis:childEPCs", "@type": "@id", "@container": "@list"},
    "quantityList": {"@id": "epcis:quantityList", "@container": "@list"},
    "childQuantityList": {"@id": "epcis:childQuantityList", "@container": "@list"},
    "inputEPCList": {"@id": "epcis:inputEPCList", "@type": "@id", "@container": "@list"},
    "inputQuantityList": {"@id": "epcis:inputQuantityList", "@container": "@list"},
    "outputEPCList": {"@id": "epcis:outputEPCList", "@type": "@id", "@container": "@list"},
    "outputQuantityList": {"@id": "epcis:outputQuantityList", "@container": "@list"},
    "epcClass": {"@id": "epcis:epcClass", "@type": "@id"},
    "quantity": "epcis:quantity",
    "uom": "epcis:uom",
    "sourceList": {"@id": "epcis:sourceList", "@container": "@list"},
    "destinationList": {"@id": "epcis:destinationList", "@container": "@list"},
    "source": {"@id": "epcis:source", "@type": "@id"},
    "destination": {"@id": "epcis:destination", "@type": "@id"}
  }
}
