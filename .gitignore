# Python
__pycache__/
*.pyc

# Scale-reproduction artifacts are generated at runtime into temp dirs and
# must never be committed (see scripts/settle_scale.py --keep --work).
epcis-settle-scale-*/
epcis-cold-scale-*/
settle-out/

# Drill work directories hold generated warehouses, inputs and outputs.
drills/*/work/

# Disclosure scale-reproduction artifacts are generated at runtime into
# temp dirs and must never be committed (see scripts/disclosure_scale.py).
epcis-disc-scale-*/
